const CACHE_NAME = 'kerem-sertifika-v1';
const urlsToCache = [
  './index.html',
  './manifest.json'
  // Projenizde kullandığınız ana CSS/JS dosyaları varsa buraya ekleyebilirsiniz
];

// Yükleme aşaması
self.addEventListener('install', event => {
  event.waitUntil(
    caches.open(CACHE_NAME)
      .then(cache => cache.addAll(urlsToCache))
  );
});

// Fetch (Ağ istekleri) aşaması
self.addEventListener('fetch', event => {
  event.respondWith(
    caches.match(event.request)
      .then(response => response || fetch(event.request))
  );
});